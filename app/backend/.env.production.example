# =============================================================================
# Shop Shift — BACKEND production environment
# Copy to `.env` on the server and fill in every REQUIRED value.
# Never commit the real .env — it holds live secrets.
# =============================================================================

APP_NAME="Shop Shift"
APP_ENV=production
# REQUIRED: generate once on the server -> php artisan key:generate
APP_KEY=
APP_DEBUG=false
# REQUIRED: your public HTTPS domain (no trailing slash)
APP_URL=https://app.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# --- Logging ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning        # never `debug` in production

# --- Database (MySQL) ------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=store_shift
DB_USERNAME=store_shift
DB_PASSWORD=

# --- Cache / queue / sessions (Redis) --------------------------------------
# Migrations MUST run on a real queue. Never use QUEUE_CONNECTION=sync here.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none        # required: the app runs inside Shopify's iframe

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Horizon supervises the queue workers: php artisan horizon
HORIZON_PREFIX=store_shift_horizon

# --- Shopify app -----------------------------------------------------------
# REQUIRED: from your Partner Dashboard (Client ID / Client secret)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=write_products,write_customers,read_products,read_customers,write_inventory,read_orders,write_orders
# REQUIRED: same public HTTPS base URL as APP_URL (no trailing slash).
# Partner Dashboard App URL  -> {SHOPIFY_APP_URL}/api/auth
# Allowed redirection URL    -> {SHOPIFY_APP_URL}/api/auth/callback
SHOPIFY_APP_URL=https://app.yourdomain.com
# Clock-skew allowance (seconds) when validating session tokens.
SHOPIFY_TOKEN_LEEWAY=60

# --- Migration engine tuning ----------------------------------------------
MIGRATION_PER_PAGE=100

# ABSOLUTE ceiling on concurrent batches for one shop — the last word, whatever
# any per-entity ceiling says. The real number is derived from the shop's measured
# Shopify API budget; this is the upper bound.
#
# Deliberately higher than MIGRATION_SOURCE_CONCURRENCY below. The two guard
# different things, and while they were the same number the per-entity ceilings
# could never rise above it — setting the enterprise order ceiling to 12 did
# nothing at all, because this clipped it back to 8 first.
MIGRATION_MAX_CONCURRENCY=12

# Concurrent batches for entities that READ WooCommerce heavily — products,
# categories, customers, coupons and content. This is the bound that protects the
# merchant's WordPress host rather than Shopify: a product batch reads variations
# and image metadata per record. Lower it if merchants report their store
# struggling during a migration.
MIGRATION_SOURCE_CONCURRENCY=8

# How many ORDER batches may run at once, PER SHOPIFY TIER. Shopify meters
# orderCreate separately from the GraphQL point budget, so orders carry their own
# ceiling on top of MIGRATION_MAX_CONCURRENCY above — the smaller of the two wins.
#
# The tier comes from the shop's measured API restore rate: Basic and Grow are
# both `standard`, then advanced / plus / enterprise. Leave unset to use the
# defaults shown. Raising one is safe to try: if Shopify refuses, the batch backs
# off and settles at the real limit, and no order is lost or duplicated. Note that
# enterprise cannot exceed MIGRATION_MAX_CONCURRENCY.
#MIGRATION_ORDER_CONCURRENCY_STANDARD=2
#MIGRATION_ORDER_CONCURRENCY_ADVANCED=3
#MIGRATION_ORDER_CONCURRENCY_PLUS=6
#MIGRATION_ORDER_CONCURRENCY_ENTERPRISE=8
MIGRATION_SHOPIFY_CONCURRENCY=2
MIGRATION_WEIGHT_UNIT=KILOGRAMS
MIGRATION_META_NAMESPACE=woocommerce
MIGRATION_SKIP_META_KEYS=
MIGRATION_CREATE_METAFIELD_DEFINITIONS=true
MIGRATION_BRANDS_AS_TAGS=true
MIGRATION_DEFAULT_VENDOR=

# --- Super Admin seed ------------------------------------------------------
# Used ONLY by `php artisan db:seed --class=AdminSeeder`.
# REQUIRED: set a strong password — never ship the default.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Mail (migration notifications — optional) -----------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Deployment checklist --------------------------------------------------
# 1) composer install --no-dev --optimize-autoloader
# 2) php artisan key:generate           (once)
# 3) php artisan migrate --force
# 4) php artisan db:seed --class=AdminSeeder --force
# 5) php artisan config:cache route:cache view:cache
# 6) run Horizon as a supervised service:  php artisan horizon
# 7) point the web root at backend/public and force HTTPS
SHOPIFY_BILLING_TEST=true
# false (Shopify default): cancelling issues no credit and the merchant keeps the
# plan until the end of the period already paid for. true: prorated credit, plan
# ends immediately (the credit is deducted from the Partner payout).
SHOPIFY_BILLING_PRORATE_CANCELLATIONS=false
