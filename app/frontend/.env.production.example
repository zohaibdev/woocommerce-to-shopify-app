# =============================================================================
# Shop Shift — FRONTEND production environment
# Copy to `.env.production` before building:  npm run build
# NOTE: every VITE_* value is embedded in the JS bundle and is PUBLIC.
#       Never put secrets here (no API secret, no tokens).
# =============================================================================

# REQUIRED: Shopify Client ID — must match the backend's SHOPIFY_API_KEY.
# Rendered into <meta name="shopify-api-key"> for App Bridge.
VITE_SHOPIFY_API_KEY=

# API base URL.
# Leave as /api when the frontend is served from the same domain as the backend
# (recommended — avoids CORS entirely). Otherwise use the full origin, e.g.
# https://api.yourdomain.com/api
VITE_API_URL=/api
